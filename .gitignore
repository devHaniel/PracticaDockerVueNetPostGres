```gitignore
# =========================
# Environment / Secrets
# =========================
.env
.env.local
.env.*.local

# =========================
# .NET / C#
# =========================
**/bin/
**/obj/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# VS Code
.vscode/

# Logs
**/*.log

# Test results
**/TestResults/
**/coverage/

# NuGet
**/*.nupkg
**/*.snupkg

# =========================
# Node / Vue
# =========================
**/node_modules/
**/dist/
**/.output/

# NPM / Yarn / PNPM logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# OS
# =========================
.DS_Store
Thumbs.db
```
